# Gemini API Key (legacy/current platform usage)
GEMINI_API_KEY=

# Resend API Key for real email sending
RESEND_API_KEY=

# Stripe Configuration
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Supabase browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Recruiting OS server-side persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte base64 key used for AES-256-GCM credential encryption.
# Generate locally with: openssl rand -base64 32
SMARTSCOUT_VAULT_KEY=

# Licensed candidate-source APIs. Smart Scout only calls sources for which the customer has permission.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
NAUKRI_CLIENT_ID=
NAUKRI_CLIENT_SECRET=

# Provider-neutral production integrations. Keep secrets server-side.
CALENDAR_PROVIDER=
CALENDAR_API_URL=
CALENDAR_API_TOKEN=
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
COMPENSATION_PROVIDER=
COMPENSATION_API_URL=
COMPENSATION_API_KEY=
HRIS_PROVIDER=
HRIS_API_URL=
